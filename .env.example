# ---------------------------------------------------------------------------
# Website (Build-Zeit, öffentlich sichtbar – nur PUBLIC_-Werte, keine Geheimnisse)
# ---------------------------------------------------------------------------
PUBLIC_SITE_URL=https://bcube.at
# Plausible: Domain wie im Plausible-Dashboard angelegt. Leer = Tracking nur in der Konsole.
PUBLIC_PLAUSIBLE_DOMAIN=
PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
# Cloudflare Turnstile Site Key. Lokal den offiziellen Test-Key verwenden:
# 1x00000000000000000000AA (besteht immer)
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Selbst gehostete Protomaps-Kacheln (siehe README "Karte"). Leer = OpenFreeMap als Fallback.
PUBLIC_MAP_PMTILES_URL=
# Social-Proof-Abschnitt anzeigen (erst wenn echte Zitate/Zahlen vorliegen)
PUBLIC_SHOW_SOCIAL_PROOF=false
# Manuell gepflegte Zahl der Vormerkungen (leer = nicht anzeigen)
PUBLIC_LEAD_COUNT=

# ---------------------------------------------------------------------------
# Lokale Funktion (npm run dev:api) – in AWS kommen diese Werte aus Terraform/SSM
# ---------------------------------------------------------------------------
STAGE=local
SITE_URL=http://localhost:4321
MAIL_FROM="BCube <hallo@bcube.at>"
MAIL_REPLY_TO=hallo@bcube.at
# Empfänger der Benachrichtigung über neue bestätigte Vormerkungen
NOTIFY_EMAIL=
# Turnstile Secret. Test-Secret, das immer besteht: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Nur lokal: Turnstile-Prüfung überspringen (z. B. offline). In AWS ignoriert.
TURNSTILE_BYPASS=false
# Zufälliger Wert zum Hashen von IP-Adressen (openssl rand -base64 32)
IP_HASH_SALT=local-dev-salt
CONSENT_VERSION=2026-10-v1
LOCAL_API_PORT=8787
