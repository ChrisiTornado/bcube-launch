---
import Base from '../layouts/Base.astro';
---

<Base title="Bestätigung fehlgeschlagen | BCube" description="Bestätigung fehlgeschlagen" noindex minimalHeader>
  <section class="section status">
    <div class="container status__box card">
      <span class="status__icon" aria-hidden="true">!</span>
      <h1>Link ungültig oder abgelaufen</h1>
      <p>Dieser Bestätigungslink funktioniert leider nicht mehr. Bestätigungslinks sind 30 Tage gültig. Merk dich einfach noch einmal vor – das dauert nur einen Moment.</p>
      <a href="/#vormerken" class="btn btn-primary">Zur Startseite</a>
    </div>
  </section>
</Base>

<style>
  .status__box {
    max-width: 40rem;
    margin-inline: auto;
    padding: clamp(2rem, 6vw, 3.5rem);
    text-align: center;
    border-radius: var(--radius-panel);
  }
  .status__icon {
    display: inline-grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--bcube-orange);
    color: var(--bcube-ink);
    font-size: 2rem;
    font-weight: var(--fw-black);
  }
  h1 {
    margin-top: var(--space-lg);
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    text-transform: uppercase;
    letter-spacing: var(--tracking-title);
  }
  p {
    margin: var(--space-md) 0 var(--space-xl);
    color: var(--bcube-text-soft);
  }
</style>
