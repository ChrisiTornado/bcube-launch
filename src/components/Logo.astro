---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.jpg';

interface Props {
  size?: number;
}
const { size = 40 } = Astro.props;
---

<span class="logo">
  <Image src={logo} alt="" width={size} height={size} densities={[1, 2, 3]} class="logo__mark" loading="eager" />
  <span class="logo__text">cube</span>
  <span class="visually-hidden">BCube</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .logo__mark {
    border-radius: 10px;
    border: 1px solid var(--bcube-line);
  }
  .logo__text {
    color: var(--bcube-text);
    font-size: 1.55rem;
    font-weight: var(--fw-black);
    letter-spacing: -0.01em;
    line-height: 1;
  }
</style>
