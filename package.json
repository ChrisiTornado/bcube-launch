    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/client-sesv2": "^3.1149.0",
    "@aws-sdk/client-ssm": "^3.1149.0",
    "@aws-sdk/lib-dynamodb": "^3.1149.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
