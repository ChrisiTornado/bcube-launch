{
  "name": "bcube-launch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BCube Launch One-Pager mit Vormerkung, Studiokarte und Tracking",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:api": "tsx watch dev/local-api.ts",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "build:function": "node scripts/build-function.mjs",
    "export:studios": "tsx scripts/export-studios.ts",
    "export:leads": "tsx scripts/export-leads.ts",
    "og": "tsx scripts/generate-og.ts",
    "ci": "npm run lint && npm run check && npm run test && npm run build && npm run build:function"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@protomaps/basemaps": "^5.7.2",
